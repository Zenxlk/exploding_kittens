# Copiar a .env (no versionado, ver .gitignore) y completar con las
# credenciales del proyecto Supabase — las mismas que usa el backend
# cards_game_service para SUPABASE_JWKS_URL (ver su docs/DEPLOYMENT.md).
# SUPABASE_ANON_KEY es pública por diseño, pensada para clientes.
#
# Sin este archivo (o con las variables vacías), SupabaseConfig.isConfigured
# da false y la app arranca en modo 100% invitado — no hace falta para
# desarrollar ni para correr los tests.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# URL base de una instancia de cards_game_service (https://... o http://
# para pruebas locales) — sin esquema wss/ws, OnlineConfig lo deriva solo.
# Sin esta variable, OnlineConfig.isConfigured da false y el modo online no
# aparece como opción en la UI (la app sigue jugando LAN/invitado igual que
# hoy). No hay un valor por defecto: no está atado a ninguna instancia
# desplegada en particular, ver cards_game_service/docs/DEPLOYMENT.md.
ONLINE_SERVER_URL=
