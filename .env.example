# Copiar a .env (no versionado, ver .gitignore) y completar con las
# credenciales del proyecto Supabase — las mismas que usa el backend
# cards_game_service para SUPABASE_JWKS_URL (ver su docs/DEPLOYMENT.md).
# SUPABASE_ANON_KEY es pública por diseño, pensada para clientes.
#
# Sin este archivo (o con las variables vacías), SupabaseConfig.isConfigured
# da false y la app arranca en modo 100% invitado — no hace falta para
# desarrollar ni para correr los tests.
SUPABASE_URL=
SUPABASE_ANON_KEY=
